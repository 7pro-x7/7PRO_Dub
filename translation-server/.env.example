# Same project the app uses (public anon key — the server only ever acts AS the caller).
SUPABASE_URL=https://usbfrqbjtpvnkmmcusdi.supabase.co
SUPABASE_ANON_KEY=sb_publishable_z4-FFrrgruER4BwM10qV_A_C0dcN6CW

# cuda (recommended) or cpu
DEVICE=cuda
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=float16

# Languages offered in the meeting (each needs a Piper voice; defaults cover these six)
LANGUAGES=ar,en,fr,de,es,tr
# Optional override of the Piper voice per language, JSON:
# PIPER_VOICES={"en":"en_US-ryan-high"}

# Re-voice translations with the speaker's own timbre (OpenVoice V2)
VOICE_CLONE=true

# Browser origins allowed to call /health (the WebSocket itself is authorised by Supabase JWT)
ALLOWED_ORIGINS=https://7pro-x7.7pro7777.workers.dev,https://7pro-x7.netlify.app

# Dubbing feature: service_role key, used ONLY by this server (never ship it in the app)
SUPABASE_SERVICE_ROLE_KEY=
