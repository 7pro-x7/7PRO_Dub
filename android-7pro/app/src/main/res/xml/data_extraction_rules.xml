<?xml version="1.0" encoding="utf-8"?>
<!--
  The signed-in Supabase session lives in shared preferences. Copying it to another device
  through cloud backup or device transfer would move a live session with it, so both are
  disabled; a user simply signs in again on the new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
